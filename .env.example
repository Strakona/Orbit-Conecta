# Firebase Web App Config (Project: sistema-laboratorio-inovacao | #760661763459)
# Copie para .env.local para testar localmente e configure na Vercel (Environment Variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sistema-laboratorio-inovacao.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sistema-laboratorio-inovacao
VITE_FIREBASE_STORAGE_BUCKET=sistema-laboratorio-inovacao.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=760661763459
VITE_FIREBASE_APP_ID=

# Chave Gemini API protegida no servidor (Vercel Serverless Function /api/gemini)
# NÃO prefixar com VITE_ para nunca vazar no bundle do navegador!
GEMINI_API_KEY=

# Códigos institucionais opcionais (padrão: CEMI2026 / SMED2026)
VITE_PROFESSOR_PIN=CEMI2026
VITE_COORDINATOR_PIN=SMED2026
